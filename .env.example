APP_NAME=LCPortalCICD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cicd.lcportal.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---- Admin login (seeded once via AdminUserSeeder) ----
CICD_ADMIN_EMAIL=admin@lcportal.cloud
CICD_ADMIN_PASSWORD=change-this-now
CICD_ADMIN_NAME="CICD Admin"

# Root directory on the VPS that holds the deployed app folders.
# Pipeline step "working directory" paths live under here.
CICD_APPS_ROOT=/root/core/apps

# ---- Database (external MySQL on the VPS) ----
# Inside Docker, host.docker.internal resolves to the VPS host (extra_hosts maps it).
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=lcportal_cicd
DB_USERNAME=lcportal_cicd
DB_PASSWORD=

# ---- Weekly full MySQL backup (php artisan backup:mysql) ----
# Dumps EVERY database on the server, not just DB_DATABASE above, so this
# needs a separate MySQL account with read access across all schemas:
#   CREATE USER 'cicd_backup'@'%' IDENTIFIED BY 'STRONG_PASSWORD';
#   GRANT SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER, PROCESS ON *.* TO 'cicd_backup'@'%';
#   FLUSH PRIVILEGES;
BACKUP_DB_HOST=host.docker.internal
BACKUP_DB_PORT=3306
BACKUP_DB_USERNAME=cicd_backup
BACKUP_DB_PASSWORD=
BACKUP_MYSQL_KEEP=8

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="cicd@lcportal.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Laravel Reverb (WebSockets / live logs) ----
# Generate fresh credentials with: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# What the Reverb server binds to inside the worker container
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Public-facing values the browser uses to connect.
# Production (behind Nginx + TLS, proxied at /app):
#   REVERB_HOST=cicd.lcportal.cloud  REVERB_PORT=443  REVERB_SCHEME=https
# Local dev:
#   REVERB_HOST=localhost  REVERB_PORT=8080  REVERB_SCHEME=http
REVERB_HOST="cicd.lcportal.cloud"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
